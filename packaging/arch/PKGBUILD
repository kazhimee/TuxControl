pkgname=tuxcontrol
pkgver=0.1.0
pkgrel=1
pkgdesc='GNOME control center for apps, services, themes, and extensions'
arch=('any')
url='https://github.com/'
license=('GPL3')
depends=('python>=3.10' 'python-gobject' 'gtk4' 'systemd')
source=("tuxcontrol-${pkgver}.tar.gz" "LICENSE" "org.tuxcontrol.App.desktop")
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -d "$pkgdir/usr/lib/tuxcontrol/control_center"
  install -d "$pkgdir/usr/bin"
  install -d "$pkgdir/usr/share/applications"
  install -m 0644 "$srcdir/control_center/"*.py \
    "$pkgdir/usr/lib/tuxcontrol/control_center/"
  install -m 0644 "$srcdir/org.tuxcontrol.App.desktop" \
    "$pkgdir/usr/share/applications/org.tuxcontrol.App.desktop"
  cat > "$pkgdir/usr/bin/tuxcontrol" <<'LAUNCHER'
#!/bin/sh
export PYTHONPATH="/usr/lib/tuxcontrol${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python -m control_center.app "$@"
LAUNCHER
  chmod 0755 "$pkgdir/usr/bin/tuxcontrol"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/tuxcontrol/LICENSE"
}
